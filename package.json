{
  "name": "minotor-mcp",
  "version": "0.1.0",
  "description": "Local-first transit routing and network analysis engine for AI agents.",
  "type": "module",
  "license": "MIT",
  "author": "Aubry Cholleton <aubry@cholleton.com> (https://aubry.io)",
  "homepage": "https://github.com/aubryio/minotor-mcp#readme",
  "bugs": "https://github.com/aubryio/minotor-mcp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/aubryio/minotor-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "mn": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "test:package": "node tests/package-smoke.mjs",
    "lint": "eslint src tests --fix",
    "lint:check": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier . --check",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "env-paths": "^3.0.0",
    "luxon": "^3.7.2",
    "minotor": "13.0.1",
    "node-stream-zip": "^1.16.0",
    "string-width": "^8.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@semantic-release/changelog": "^7.0.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
